# .env.example — PersonaBot v2.0 (Grok Edition) 环境变量模板

# 应用配置
NODE_ENV=development
PORT=3000

# 大模型配置（支持 xAI Grok / OpenAI / DeepSeek / 本地 Ollama 等兼容接口）
# 留空时系统仍可启动，并自动进入离线演示兜底模式；也可在网页设置舱中动态配置
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-3

# DeepSearch 专业联网搜索（可选，未配置时默认使用免 Key 内置实时搜索）
TAVILY_API_KEY=
SERPER_API_KEY=

# 额外备选模型配置（可选）
# LLM_MODEL_2_NAME=DeepSeek Chat
# LLM_MODEL_2_KEY=
# LLM_MODEL_2_URL=https://api.deepseek.com/v1
# LLM_MODEL_2_MODEL=deepseek-chat

# MongoDB 数据库（可选，未配置时默认使用 exes/ 与 .data/ 本地结构化仓储）
# MONGODB_URI=mongodb://localhost:27017/personabot
# MONGO_USERNAME=admin
# MONGO_PASSWORD=password

# 认证与加密密钥
JWT_SECRET=change-me-in-production-jwt-secret
ENCRYPTION_KEY=change-me-in-production-encryption-key
